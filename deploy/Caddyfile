{$OBS_REMOTE_DOMAIN} {
	@pairing path /pair /pair/* /api/pair /api/pair/*
	respond @pairing 404

	basic_auth {
		{$OBS_REMOTE_USER} {$OBS_REMOTE_PASSWORD_HASH}
	}

	reverse_proxy 127.0.0.1:{$OBS_REMOTE_TUNNEL_PORT:18787} {
		header_up Host 127.0.0.1:{$OBS_REMOTE_PC_PORT:8787}
		header_up X-OBS-Remote-Proxy 1
		header_up -Authorization
		flush_interval 20ms
		transport http {
			dial_timeout 4s
			response_header_timeout 20s
		}
	}
}
